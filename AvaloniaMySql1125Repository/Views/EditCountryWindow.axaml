<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:AvaloniaMySql1125Repository.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaMySql1125Repository.Views.EditCountryWindow"
        x:DataType="viewModels:EditCountryWindowViewModel"
        Title="Редактирование страны">
    <StackPanel>
        <Label Content="Название" />
        <TextBox Text="{Binding SelectedCountry.Title}" />
        <Button Content="Сохранить" Command="{Binding SaveCommand}" />
    </StackPanel>
</Window>